APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast: Pusher (managed WebSocket — free tier su pusher.com)
# Sostituisce Reverb per compatibilità con hosting condiviso.
BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Metered.ca — TURN server per WebRTC ───────────────────────────────────
# Registrarsi su metered.ca, creare un'app, copiare API key e credenziali statiche
METERED_API_KEY=
METERED_APP_NAME=rsmioni
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

# ── Pusher — credenziali da pusher.com/dashboard ───────────────────────────
# Creare un'app su pusher.com (Channels, free tier: 200k msg/day, 100 conn)
# Cluster: eu (Europa) raccomandato per iweblab
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── LiveKit Cloud — media WebRTC gestito (SFU + signaling + TURN) ───────────
# Credenziali da https://cloud.livekit.io (progetto → API Keys).
# LIVEKIT_URL è il WebSocket del progetto, es. wss://nome.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI Self Check-in (worker Python esterno: ai-receptionist/) ─────────────
# Laravel NON usa la chiave Anthropic: il cervello AI vive nel worker Python.
# Le chiavi del worker stanno in ai-receptionist/.env (vedi ai-receptionist/.env.example):
#   ANTHROPIC_API_KEY, DEEPGRAM_API_KEY, ELEVENLABS_API_KEY, LIVEKIT_*

# Segreto condiviso Laravel <-> worker AI per le API /agent/* (genera con:
# php -r "echo bin2hex(random_bytes(32));"). Stesso valore di
# RSMIONI_AGENT_HMAC_SECRET nel .env del worker.
AGENT_SERVICE_TOKEN=
