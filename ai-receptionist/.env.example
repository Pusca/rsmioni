# ─────────────────────────────────────────────────────────────────────────
# ai-receptionist — variabili d'ambiente del worker AI (LiveKit Agents)
#
# Copia in `.env` e compila con valori REALI. Questo file (.env) è gitignorato.
# NON incollare mai i valori reali in chat, ticket o commit.
# Elenco allineato a checkin/config.py — è lì la fonte di verità.
# ─────────────────────────────────────────────────────────────────────────

# LiveKit Cloud — gli STESSI valori del .env di Laravel (stesso progetto/stanza)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cervello AI (tool calling + ragionamento) ────────────────────────────
# Serve ALMENO UNA delle due chiavi. Priorità: se OPENROUTER_API_KEY è
# presente, il worker usa OpenRouter e IGNORA l'API Anthropic nativa per la
# conversazione.
#
# OpenRouter è OPZIONALE per la conversazione ma NECESSARIO per la vision
# documenti: l'estrazione dati dal documento d'identità passa SOLO da
# OpenRouter. Senza OPENROUTER_API_KEY l'estrazione viene saltata
# (warning nei log, il check-in prosegue senza lettura automatica).
OPENROUTER_API_KEY=
# Modello OpenRouter per i turni di conversazione (default: anthropic/claude-sonnet-4.6)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Modello OpenRouter per la lettura del documento d'identità — chiamata
# one-shot dove conta l'accuratezza, separata dal cervello conversazionale.
# (default: anthropic/claude-sonnet-4.6)
VISION_MODEL=anthropic/claude-sonnet-4.6

# API Anthropic nativa — usata per la conversazione SOLO se OPENROUTER_API_KEY
# è assente. Non abilita la vision documenti (che è solo via OpenRouter).
ANTHROPIC_API_KEY=
# Modello Anthropic per i turni di conversazione (default: claude-sonnet-4-6,
# vedi docs/09-ai-self-checkin.md)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Limite di token per singola risposta del LLM (default: 600 — risposte
# brevi, adatte alla voce)
LLM_MAX_TOKENS=600

# ── STT — speech-to-text multilingua con language detection ──────────────
# Obbligatoria: senza, niente riconoscimento vocale.
DEEPGRAM_API_KEY=

# ── TTS — voce naturale multilingua a bassa latenza ──────────────────────
# Obbligatoria: senza, niente sintesi vocale.
ELEVENLABS_API_KEY=
# ID della voce ElevenLabs (default: Xb7hH8MSUJpSbSDYk0k2)
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
# Modello TTS ElevenLabs (default: eleven_flash_v2_5 — bassa latenza)
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Backend RS Mioni — tool call di dominio verso Laravel ────────────────
# Base URL dell'app Laravel (default: http://localhost:8000)
RSMIONI_API_BASE_URL=http://localhost:8000
# Token condiviso STATICO con Laravel (stesso valore di AGENT_SERVICE_TOKEN
# nel .env Laravel). Nonostante il nome, oggi NON è una firma HMAC: viene
# inviato così com'è nell'header `X-Agent-Token` come bearer token statico.
# L'hardening con firma HMAC per-richiesta è pianificato (assumptions A26).
# Senza questo valore le tool call verso Laravel vengono rifiutate (401).
RSMIONI_AGENT_HMAC_SECRET=

# Lingua di partenza prima del rilevamento automatico (default: it)
AGENT_DEFAULT_LANGUAGE=it
