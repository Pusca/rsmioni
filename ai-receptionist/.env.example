# ─────────────────────────────────────────────────────────────────────────
# ai-receptionist — variabili d'ambiente del worker AI (LiveKit Agents)
#
# Copia in `.env` e compila con valori REALI. Questo file (.env) è gitignorato.
# NON incollare mai i valori reali in chat, ticket o commit.
# Elenco allineato a checkin/config.py — è lì la fonte di verità.
# ─────────────────────────────────────────────────────────────────────────

# LiveKit Cloud — gli STESSI valori del .env di Laravel (stesso progetto/stanza)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cervello AI (tool calling + ragionamento) ────────────────────────────
# Provider in ordine di preferenza, separati da virgola:
#   auto (default)         = API Anthropic diretta se c'è la chiave, poi OpenRouter di riserva
#   anthropic              = solo API Anthropic
#   openrouter             = solo OpenRouter
#   openrouter,anthropic   = OpenRouter prima, Anthropic se fallisce
# Con più provider la cascata è automatica (FallbackAdapter): credito finito
# (402) o API giù sul primo → il turno passa al successivo, la sessione vive.
# La lettura del documento d'identità segue lo stesso ordine.
LLM_PROVIDER=auto

# API Anthropic diretta — consigliata: un salto di rete in meno, prompt
# caching nativo (istruzioni e tool identici a ogni turno costano ~1/10),
# modelli più recenti a listino.
ANTHROPIC_API_KEY=
# Modello per i turni di conversazione (default: claude-sonnet-5-5).
# Per la massima velocità provare claude-haiku-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modello per la lettura del documento d'identità (default: claude-sonnet-5-5)
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# Profondità di ragionamento per turno: low | medium | high (default: low —
# in voce conta la risposta immediata, il processo è già nei tool).
LLM_EFFORT=low

# OpenRouter — opzionale, come riserva o in alternativa.
OPENROUTER_API_KEY=
# Modello OpenRouter per i turni di conversazione (default: anthropic/claude-sonnet-4.6)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Modello OpenRouter per la lettura del documento (default: anthropic/claude-sonnet-4.6)
VISION_MODEL=anthropic/claude-sonnet-4.6

# Limite di token per singola risposta del LLM (default: 600 — risposte
# brevi, adatte alla voce)
LLM_MAX_TOKENS=600

# ── STT — speech-to-text multilingua con language detection ──────────────
# Obbligatoria: senza, niente riconoscimento vocale.
DEEPGRAM_API_KEY=
# Lingua della trascrizione: chiosco (default) = quella scelta dall'ospite
# con le bandierine (it/en/de/fr/es); auto = rilevamento automatico fra tutte
# le lingue — in produzione (30/10/2026) scambiava rumore e italiano per
# ebraico/croato e spegneva il turn detector. Usare auto solo se l'ospite
# può parlare una lingua non prevista dal chiosco.
# STT_LANGUAGE=chiosco

# ── TTS — voce naturale multilingua a bassa latenza ──────────────────────
# Provider della voce, in ordine di preferenza, separati da virgola:
#   auto (default)        = ElevenLabs se c'è la chiave, poi Deepgram di riserva
#   cartesia,deepgram     = Cartesia Sonic-3 via LiveKit Inference, Deepgram se fallisce  ← consigliato per provare
#   inworld,deepgram      = Inworld TTS-2 via LiveKit Inference, Deepgram se fallisce
#   deepgram              = solo Deepgram Aura-2 (usa DEEPGRAM_API_KEY, nessun altro account)
#   elevenlabs            = solo ElevenLabs
# Cartesia e Inworld NON richiedono account né chiavi: li serve LiveKit Cloud
# con le credenziali LIVEKIT_* qui sopra, a minuto sulla fattura LiveKit (il
# piano Build include un credito gratuito). Entrambi parlano italiano e
# accettano TTS_SPEED anche in italiano. Confronto all'ascolto: `python prova_voce.py`.
# Con più provider la cascata è automatica (FallbackAdapter): se il primo non
# produce audio — es. ElevenLabs con pagamento sospeso — parla il successivo.
TTS_PROVIDER=auto
# Modello e voci Cartesia per lingua (default cartesia/sonic-3; it=Italian
# Narrator Woman, en=Jacqueline, es=Daniela; altre lingue → voce "en").
# ID dalla libreria play.cartesia.ai (niente voci clonate su Inference).
# CARTESIA_MODEL=cartesia/sonic-3
# CARTESIA_VOICES=it=0e21713a-5e9a-428a-bed4-90d410b87f13
# Modello e voci Inworld per lingua, per NOME (default inworld/inworld-tts-2;
# it=Orietta, en=Ashley, es=Diego; altre lingue → "en", le voci sono multilingua).
# inworld/inworld-tts-2-flash = più economico e veloce, un po' meno naturale.
# INWORLD_MODEL=inworld/inworld-tts-2
# INWORLD_VOICES=it=Orietta,en=Ashley
# Voci Deepgram Aura-2 per lingua (override dei default aura-2-livia-it,
# aura-2-thalia-en, aura-2-viktoria-de, aura-2-celeste-es, aura-2-agathe-fr):
# DEEPGRAM_TTS_VOICES=it=aura-2-cinzia-it,en=aura-2-helena-en
# Lingue le cui voci Aura-2 accettano TTS_SPEED (default: en,es). Sulle altre
# Deepgram risponde 400 e l'assistente resterebbe muto: l'italiano NON la
# supporta (29/10/2026), quindi parla a velocità naturale.
# DEEPGRAM_SPEED_LANGS=en,es
# Chiave ElevenLabs: serve solo se il provider la include.
ELEVENLABS_API_KEY=
# ID della voce ElevenLabs (default: Xb7hH8MSUJpSbSDYk0k2)
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
# Modello TTS ElevenLabs (default: eleven_flash_v2_5 — bassa latenza)
ELEVENLABS_MODEL=eleven_flash_v2_5
# ATTENZIONE: la API key ElevenLabs inizia con "sk_". Nella pagina delle
# chiavi c'è anche un "ID" della chiave (64 caratteri esadecimali): NON è
# quello — se lo incolli qui ElevenLabs risponde api_key_id_used_as_api_key
# e l'assistente resta muto. Il worker lo segnala all'avvio.
# Carattere della voce (opzionali): stability bassa = più espressiva,
# alta = più piatta (solo ElevenLabs). TTS_SPEED vale per TUTTI i provider:
# 1.0 = velocità naturale, default 1.2 (in demo a 1.0 Alice risultava lenta);
# ElevenLabs 0.7–1.2, Cartesia 0.6–1.5, Inworld 0.5–1.5, Deepgram Aura-2
# 0.7–1.5 (ma non in italiano, vedi DEEPGRAM_SPEED_LANGS).
TTS_STABILITY=0.5
TTS_SIMILARITY=0.8
TTS_STYLE=0.0
TTS_SPEED=1.2

# ── Backend RS Mioni — tool call di dominio verso Laravel ────────────────
# Base URL dell'app Laravel (default: http://localhost:8000)
RSMIONI_API_BASE_URL=http://localhost:8000
# Token condiviso STATICO con Laravel (stesso valore di AGENT_SERVICE_TOKEN
# nel .env Laravel). Nonostante il nome, oggi NON è una firma HMAC: viene
# inviato così com'è nell'header `X-Agent-Token` come bearer token statico.
# L'hardening con firma HMAC per-richiesta è pianificato (assumptions A26).
# Senza questo valore le tool call verso Laravel vengono rifiutate (401).
RSMIONI_AGENT_HMAC_SECRET=

# Lingua di partenza prima del rilevamento automatico (default: it)
AGENT_DEFAULT_LANGUAGE=it

# Lettura/verifica vision del documento acquisito (default: auto = decide
# Laravel per hotel: gli hotel DEMO accettano la foto così com'è, senza
# leggerla, e il nome resta quello dato a voce). on = sempre, off = mai.
DOC_VERIFICA=auto
